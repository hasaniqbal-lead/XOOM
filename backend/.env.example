# Server Configuration
NODE_ENV=development
PORT=3000
SOCKET_PORT=3001

# Database
DATABASE_URL=postgresql://xoom_user:xoom_password@localhost:5432/xoom
DB_HOST=localhost
DB_PORT=5432
DB_USER=xoom_user
DB_PASSWORD=xoom_password
DB_NAME=xoom

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Admin
ADMIN_PHONE=+923001234567
ADMIN_PASSWORD=admin123

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ============================================================================
# MAP PROVIDERS CONFIGURATION
# ============================================================================

# Primary Map Provider: nominatim (free), mapbox (free tier), google (paid)
MAP_PROVIDER=nominatim

# Nominatim + OSRM (100% Free - Default)
# No API key required, but respect rate limits (1 req/sec)
MAP_USER_AGENT=XOOM-RideHailing/1.0

# Mapbox (Free tier: 50,000 requests/month)
# Get API key from: https://www.mapbox.com/
MAPBOX_API_KEY=

# Google Maps (Paid - $200 free credit/month)
# Get API key from: https://console.cloud.google.com/
# Enable: Geocoding API, Places API, Directions API, Distance Matrix API
GOOGLE_MAPS_API_KEY=
